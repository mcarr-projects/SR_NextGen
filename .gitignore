# Git ignore rules

# Other
Research/
migration_export.json
tempCodeRunnerFile.py

# === Environment files ===
.env
.env.*       # in case you have .env.local or .env.dev

# === Python cache and build artifacts ===
__pycache__/
*.py[cod]
*.egg
*.egg-info/
dist/
build/

# === SQLite databases ===
*.db
*.sqlite3
*.db.backup*


# === Backup files ===
*.bak
*.tmp
*.swp